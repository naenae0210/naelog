---
// 홈(전체 글)과 로그별 목록이 같이 쓰는 화면. log 를 넘기면 그 로그의 글만 보인다.
// lang="en" 이면 영어판 목록(/en/, /en/<log>/)이다.
// 글은 전부 HTML에 넣고, 화면에는 10개씩 보여 준다. 바닥까지 스크롤하면 10개를 더 연다(아래 script).
import { listPosts } from '../posts';
import { LOGS, SITE, SITE_EN, logOf } from '../logs';
interface Props { log?: string; lang?: 'ko' | 'en' }
const { log, lang = 'ko' } = Astro.props;
const en = lang === 'en';
const current = log ? logOf(log) : null;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = en ? `${base}en/` : base;
const posts = listPosts(lang, log);
const hrefOf = (p: { lang: string; slug: string }) => `${base}${p.lang === 'en' ? 'en/' : ''}posts/${p.slug}/`;
const info = en ? (current?.en ?? SITE_EN) : (current ?? SITE);
const nav = LOGS.map((l) => ({ href: `${home}${l.id}/`, name: l.name, current: l.id === log }));
// 같은 목록의 다른 언어판
const path = log ? `${log}/` : '';
const alt = en ? { lang: 'ko', href: `${base}${path}` } : { lang: 'en', href: `${base}en/${path}` };
// 주제 필터는 dev 목록에서만 쓴다. book, scrap은 저자와 매체가 너무 많아 버튼이 늘어진다.
const categories = log === 'dev' ? [...new Set(posts.map((p) => p.category))] : [];
const fmtDate = (d: string) => d.replaceAll('-', '.');
// 시리즈 글은 주제 대신 "LLM 서빙 1편"처럼 시리즈와 편 번호를 보여 준다
const label = (p: { series: string; part: number; category: string }) =>
  p.series && p.part ? (en ? `${p.series} · Part ${p.part}` : `${p.series} ${p.part}편`) : p.category;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{current ? `${current.name} · ${SITE.name}` : SITE.name}</title>
  <meta name="description" content={info.intro || info.heading} />
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
  <link rel="stylesheet" href={`${base}assets/naedevlog.css`} />
  <script is:inline src={`${base}assets/site.js`}></script>
  <style>
    .intro { padding: 24px 0 48px; }
    .intro h1 { font-size: clamp(30px, 4.4vw, 40px); margin-bottom: 12px; }
    .intro p { color: var(--sub); font-size: 18px; margin: 0; }

    .cats { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }
    .cat { cursor: pointer; border: 0; background: var(--surface-2); color: var(--sub); font: 600 13px var(--font);
      padding: 6px 12px; border-radius: 99px; }
    .cat[aria-pressed="true"] { background: var(--text); color: var(--bg); }

    .list { list-style: none; padding: 0; margin: 0; }
    .list li { margin: 0; border-bottom: 1px solid var(--line); }
    .list a { display: block; padding: 28px 0; color: var(--text); }
    .list a:hover { text-decoration: none; }
    .list a:hover .t { color: var(--blue); }
    .c { font-size: 14px; font-weight: 700; color: var(--blue); }
    .t { font-size: 21px; font-weight: 700; letter-spacing: -.02em; line-height: 1.45; margin: 4px 0 8px; transition: color .15s; }
    .m { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; font-size: 14px; color: var(--faint); }
    .m .tag { font-size: 12px; padding: 1px 8px; }
    .empty { color: var(--faint); padding: 48px 0; text-align: center; }
    .more { height: 1px; }
    [hidden] { display: none !important; }
    @media (max-width: 600px) { .t { font-size: 19px; } .list a { padding: 22px 0; } }
  </style>
</head>
<body>
  <header class="site-header"><div class="inner">
    <a class="logo" href={home}>{SITE.name}</a>
    <nav class="nav">
      {nav.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.name}</a>)}
    </nav>
  </div></header>

  <main class="wrap">
    <section class="intro">
      <h1>{info.heading}</h1>
      {info.intro && <p>{info.intro}</p>}
    </section>

    {categories.length > 1 && (
      <div class="cats">
        <button class="cat" data-cat="all" aria-pressed="true">{en ? 'All topics' : '모든 주제'}</button>
        {categories.map((c) => <button class="cat" data-cat={c} aria-pressed="false">{c}</button>)}
      </div>
    )}

    <ul class="list">
      {posts.map((p) => (
        <li data-cat={p.category}>
          <a href={hrefOf(p)}>
            <div class="c">{current ? label(p) : `${logOf(p.log).name} · ${label(p)}`}</div>
            <div class="t">{p.title}</div>
            <div class="m">
              <span>{fmtDate(p.date)}</span>
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <div class="more" aria-hidden="true"></div>
    <p class="empty" hidden>{en ? 'No posts yet.' : '아직 글이 없다.'}</p>
  </main>
  <footer class="site-footer">{SITE.name} · {info.intro || info.heading}</footer>

  <script>
    // 처음 STEP개만 보여 주고, 목록 끝(.more)이 화면에 들어오면 STEP개씩 더 연다.
    // 펼친 개수는 세션에 남겨서, 글을 보고 뒤로 왔을 때 같은 만큼 다시 펼친다.
    const STEP = 10;
    const KEY = 'naelog-shown:' + location.pathname;
    const items = [...document.querySelectorAll<HTMLElement>('.list li')];
    const more = document.querySelector<HTMLElement>('.more')!;
    let cat = 'all';
    let limit = STEP;
    try { limit = Math.max(STEP, Number(sessionStorage.getItem(KEY)) || STEP); } catch (e) {}

    let matched = 0;
    const apply = () => {
      matched = 0;
      items.forEach((li) => {
        const match = cat === 'all' || li.dataset.cat === cat;
        li.hidden = !match || matched >= limit;
        if (match) matched++;
      });
      document.querySelector<HTMLElement>('.empty')!.hidden = matched > 0;
      more.hidden = matched <= limit;
      try { sessionStorage.setItem(KEY, String(limit)); } catch (e) {}
    };

    new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting) && matched > limit) { limit += STEP; apply(); }
    }, { rootMargin: '400px 0px' }).observe(more);

    document.querySelectorAll<HTMLButtonElement>('.cat').forEach((b, _, all) => b.addEventListener('click', () => {
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); cat = b.dataset.cat!; limit = STEP; apply();
    }));
    apply();
  </script>
</body>
</html>
